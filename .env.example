# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Shared secret for the admin CLI and HTTP API. Must match BALA_ADMIN_TOKEN in the bot's .env.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Address the admin HTTP API (port 8790) is published on. Use this container's LAN IP so
# the bot/proxy can reach it; the Proxmox firewall limits who may connect.
# Leave unset to keep it reachable only from inside this container.
ADMIN_HTTP_BIND=

# Where the server keeps its data (SQLite database, tourney.json) and its log file.
DATA_DIR=/mnt/data/balatro/data
LOGS_DIR=/mnt/data/balatro/logs
